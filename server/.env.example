# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=simple_topic
CORS_ORIGIN=*

# ==============================================================================
# MySQL / phpMyAdmin Database Configuration
# Standard XAMPP / WAMP / phpMyAdmin defaults:
# - Host: localhost (or 127.0.0.1)
# - Port: 3306
# - User: root
# - Password: (empty by default in XAMPP/WAMP)
# ==============================================================================
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=simple_topic
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# SQLite Fallback (Optional, change DB_DIALECT=sqlite to use SQLite)
DB_STORAGE=./database.sqlite

# JWT Configuration
JWT_ACCESS_SECRET=threatsift_jwt_access_super_secret_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=threatsift_jwt_refresh_super_secret_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin (Auto-seeded on database init)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@threatsift.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Local AI / LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=Qwen3:8b
OLLAMA_TIMEOUT_MS=120000

